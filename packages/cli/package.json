{
  "name": "mnfst-cli",
  "version": "0.1.0",
  "private": true,
  "description": "Manifest management CLI (mnfst) \u2014 configure agents, providers, and routing from the terminal",
  "license": "MIT",
  "bin": {
    "mnfst": "./bin/mnfst.js"
  },
  "main": "dist/index.js",
  "scripts": {
    "build": "npm run gen && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "jest",
    "gen": "node scripts/generate-provider-catalog.cjs && node scripts/generate-skill-content.cjs"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.2",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.12",
    "typescript": "^5.7.3",
    "manifest-shared": "*",
    "prettier": "^3.0.0"
  }
}
